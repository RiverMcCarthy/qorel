<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <PackageId>Qorel</PackageId>
    <Version>1.0.0</Version>
    <Description>Type-safe query pipeline for .NET APIs. Define filterable and sortable fields once, then accept structured filter/sort/pagination requests from clients with full validation, cursor-based keyset pagination, and optional spatial bounds — minimal boilerplate, maximum flexibility.</Description>
    <PackageTags>query;filtering;sorting;cursor;pagination;api;rest</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
