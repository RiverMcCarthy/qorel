<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Qorel</PackageId>
    <Description>Type-safe filtering, sorting and cursor pagination for .NET APIs. Declare which fields clients may filter and sort once, then validate client queries against it and run them with keyset pagination.</Description>
    <PackageTags>query;filtering;sorting;cursor;pagination;keyset;api;rest</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>
</Project>
